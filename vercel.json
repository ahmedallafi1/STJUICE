{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/site/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/ops/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/menu",
      "destination": "/site/index.html"
    },
    {
      "source": "/drops",
      "destination": "/site/index.html"
    },
    {
      "source": "/build",
      "destination": "/site/index.html"
    },
    {
      "source": "/boxes",
      "destination": "/site/index.html"
    },
    {
      "source": "/gift-cards",
      "destination": "/site/index.html"
    },
    {
      "source": "/catering",
      "destination": "/site/index.html"
    },
    {
      "source": "/rewards",
      "destination": "/site/index.html"
    },
    {
      "source": "/location",
      "destination": "/site/index.html"
    },
    {
      "source": "/account",
      "destination": "/site/index.html"
    },
    {
      "source": "/about",
      "destination": "/site/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/site/index.html"
    },
    {
      "source": "/product/:id",
      "destination": "/site/index.html"
    },
    {
      "source": "/order/:id",
      "destination": "/site/index.html"
    },
    {
      "source": "/info/:slug",
      "destination": "/site/index.html"
    }
  ]
}
