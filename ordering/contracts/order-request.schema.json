{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ST. JUICE safe test order request",
  "type": "object",
  "required": ["quoteId", "paymentToken", "schedule", "customer", "allergenAcknowledged"],
  "properties": {
    "quoteId": { "type": "string", "pattern": "^quote_" },
    "paymentToken": { "type": "string", "pattern": "^test_pay_" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200, "description": "May instead be sent in the Idempotency-Key header." },
    "schedule": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00$" },
    "deliveryCheckToken": { "type": "string", "pattern": "^delivery_test_" },
    "customer": {
      "type": "object",
      "required": ["name", "email", "phone"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 40 },
        "marketingConsent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "allergenAcknowledged": { "const": true }
  },
  "additionalProperties": false
}
