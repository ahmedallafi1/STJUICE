{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ST. JUICE cart validation request",
  "type": "object",
  "required": ["service", "items"],
  "properties": {
    "service": { "enum": ["pickup", "delivery", "dine_in"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "productId", "sizeId", "quantity"],
            "properties": {
              "kind": { "const": "catalog" },
              "key": { "type": "string", "maxLength": 500 },
              "productId": { "type": "string" },
              "sizeId": { "type": "string" },
              "modifierSelections": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } },
              "instructions": { "type": "string", "maxLength": 240 },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 20 }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": ["kind", "productId", "builderSelections", "quantity"],
            "properties": {
              "kind": { "const": "builder" },
              "key": { "type": "string", "maxLength": 500 },
              "productId": { "const": "build-your-mood" },
              "builderSelections": { "type": "object" },
              "customName": { "type": "string", "maxLength": 30 },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 20 }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "tipPercent": { "enum": [0, 15, 18, 20] },
    "promoCode": { "type": "string", "maxLength": 30 }
  },
  "additionalProperties": false
}
