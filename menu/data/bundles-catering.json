{
  "meta": {
    "version": "3.0.0",
    "currency": "USD",
    "priceStatus": "hq_catalog_only",
    "leadTimeStatus": "working_requires_manager_confirmation",
    "quoteRequiredForCustomService": true,
    "note": "HQ catalog defines 40 retail items. Other boxes and packages are no longer offered as products."
  },
  "orderNowBoxes": [],
  "cateringPackages": [],
  "leadTimeRules": [
    {
      "guestCount": {
        "min": 1,
        "max": 7
      },
      "rule": "Use first available store capacity slot"
    },
    {
      "guestCount": {
        "min": 8,
        "max": 20
      },
      "minimumHours": 24
    },
    {
      "guestCount": {
        "min": 21,
        "max": 50
      },
      "minimumHours": 48
    },
    {
      "guestCount": {
        "min": 51,
        "max": 9999
      },
      "minimumBusinessDays": 5
    },
    {
      "condition": "staffed_service_or_custom_branding",
      "minimumBusinessDays": 5
    }
  ],
  "requestFields": [
    {
      "id": "contactName",
      "required": true,
      "type": "text"
    },
    {
      "id": "organization",
      "required": false,
      "type": "text"
    },
    {
      "id": "email",
      "required": true,
      "type": "email"
    },
    {
      "id": "phone",
      "required": true,
      "type": "tel"
    },
    {
      "id": "eventDate",
      "required": true,
      "type": "date"
    },
    {
      "id": "serviceTime",
      "required": true,
      "type": "time"
    },
    {
      "id": "guestCount",
      "required": true,
      "type": "number",
      "min": 1
    },
    {
      "id": "serviceMode",
      "required": true,
      "type": "select",
      "options": [
        "pickup",
        "delivery",
        "staffed_setup"
      ]
    },
    {
      "id": "venueAddress",
      "requiredWhen": {
        "serviceMode": [
          "delivery",
          "staffed_setup"
        ]
      },
      "type": "address"
    },
    {
      "id": "packageInterest",
      "required": false,
      "type": "multi_select"
    },
    {
      "id": "budgetRange",
      "required": false,
      "type": "select"
    },
    {
      "id": "dietaryAllergenNotes",
      "required": false,
      "type": "textarea"
    },
    {
      "id": "taxExemptRequest",
      "required": false,
      "type": "boolean"
    },
    {
      "id": "customBrandingRequest",
      "required": false,
      "type": "boolean"
    },
    {
      "id": "notes",
      "required": false,
      "type": "textarea"
    },
    {
      "id": "contactConsent",
      "required": true,
      "type": "boolean"
    }
  ],
  "quoteStates": [
    "request_received",
    "needs_clarification",
    "quote_prepared",
    "customer_accepted",
    "payment_required",
    "scheduled",
    "in_preparation",
    "ready_or_out_for_delivery",
    "complete",
    "canceled_or_refunded"
  ],
  "unapprovedCommercialTerms": [
    "deposit_percentage",
    "cancellation_window",
    "delivery_fee",
    "setup_fee",
    "gratuity",
    "tax_handling",
    "quote_expiration"
  ]
}
